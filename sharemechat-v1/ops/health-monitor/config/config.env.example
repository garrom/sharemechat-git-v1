# Config del vigilante de salud (obs #5). Copiar a /etc/sharemechat-health-monitor/config.env
# El fichero se carga por `source` (bash) desde bin/check-health.sh.
# La password SMTP va en secrets.env adyacente (ver secrets.env.example).
PYTHON_BIN=python3
HEALTH_URL=http://localhost:8080/actuator/health
ENV_NAME=prod
STATE_FILE=/var/lib/sharemechat-health-monitor/state.json
TIMEOUT_SECONDS=5
REALERT_MINUTES=120
SEND_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=30
EMAIL_FROM=
EMAIL_TO=
